{
  "schemaVersion": 1,
  "id": "packsync",
  "version": "${version}",
  "name": "PackSync",
  "description": "Proof of concept for distributing resource packs embedded in datapacks over Minecraft's networking protocol.",
  "authors": ["lucachinou"],
  "contact": {},
  "license": "GNU General Public License v3.0",
  "environment": "*",
  "entrypoints": {
    "fabric-datagen": [
      "com.lucachinou.packsync.client.PackSyncDataGenerator"
    ],
    "client": [
      "com.lucachinou.packsync.client.PackSyncClient"
    ],
    "main": [
      "com.lucachinou.packsync.PackSync"
    ]
  },
  "mixins": [
    "packsync.mixins.json",
    {
      "config": "packsync.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}"
  }
}
